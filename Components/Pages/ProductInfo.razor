@page "/ProductInfo"
@rendermode InteractiveServer
@using BlazorCrudApp.Models
@using BlazorCrudApp.Services
@inject ProductService Service
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="container-fluid py-4">
    <h3 class="mb-4 fw-bold text-primary">Product Management</h3>

    <!-- Form Card -->
    <div class="card shadow-sm mb-4 border-opacity-10">
        <div class="card-body">
            <h5 class="card-title mb-3">
                @(editing.Id == 0 ? "Add New Product" : "Edit Product")
            </h5>

            <div class="row g-3">
                <div class="col-12 col-md-5">
                    <label class="form-label small fw-bold">Product Name</label>
                    <input placeholder="Enter product name"
                           @bind="editing.Name"
                           class="form-control" />
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small fw-bold">Price</label>
                    <input type="number" step="0.01"
                           placeholder="0.00"
                           @bind="editing.Price"
                           class="form-control" />
                </div>

                <div class="col-12 col-sm-6 col-md-4">
                    <label class="form-label small fw-bold">Description</label>
                    <textarea placeholder="Product description..."
                              rows="2"
                              @bind="editing.Description"
                              class="form-control"></textarea>
                </div>
            </div>

            <div class="mt-4">
                <button class="btn btn-primary px-4 me-2" @onclick="Save">
                    <i class="bi bi-save me-1"></i> Save
                </button>

                @if (editing.Id != 0)
                {
                    <button class="btn btn-outline-secondary px-4" @onclick="() => editing = new()">
                        Cancel
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Filter & Report -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
        <div class="input-group" style="max-width: 400px;">
            <span class="input-group-text bg-white border-end-0">
                <i class="bi bi-plus-square-fill"></i>
            </span>
            <input type="text" @bind="searchTerm" @bind:event="oninput" placeholder="Search by name or description..."
                   class="form-control border-start-0" />
        </div>

        <button class="btn btn-outline-success px-4" @onclick="OpenInvoiceReport">Preview
        </button>
    </div>

    <!-- Products Table -->
    @if (products == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Loading products...</p>
        </div>
    }
    else if (FilteredProducts.Any() == false)
    {
        <div class="alert alert-info text-center">
            No products found matching your search
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th class="text-end">Price</th>
                            <th class="text-center" style="width:140px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in FilteredProducts)
                        {
                            <tr>
                                <td class="fw-medium">@p.Name</td>
                                <td class="text-muted">@p.Description</td>
                                <td class="text-end fw-bold">@p.Price.ToString("C")</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary me-1"
                                        @onclick="() => StartEdit(p)">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger me-1"
                                            @onclick="() => Delete(p.Id)">
                                        <i class="bi bi-trash"></i>Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<Product> products = new();
    private Product editing = new();
    private string searchTerm = "";

    private IEnumerable<Product> FilteredProducts =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? products
            : products.Where(p =>
                (p.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        products = await Service.GetProductsAsync();
        StateHasChanged();
    }

    private void StartEdit(Product p)
    {
        editing = new Product
        {
            Id = p.Id,
            Name = p.Name,
            Description = p.Description,
            Price = p.Price
        };
    }

    private async Task Save()
    {
        if (editing.Id == 0)
            await Service.AddProductAsync(editing);
        else
            await Service.UpdateProductAsync(editing);

        editing = new Product();
        await Load();
    }

    private async Task Delete(int id)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this product?");
        if (confirm)
        {
            await Service.DeleteProductAsync(id);
            await Load();
        }
    }

    private async Task OpenInvoiceReport()
    {
        // Option 1: Direct API endpoint (most common approach)
        var reportUrl = Nav.ToAbsoluteUri("/api/report/products/all");
        // Option 2: If you have order id: "/api/report/invoice/" + orderId

        await JS.InvokeVoidAsync("open", reportUrl, "_blank");
    }
}